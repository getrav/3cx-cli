# ── CLI Entry Point ────────────────────────────────────────────────────────────

def main():
    parser = config_parser.build_parser(_runtime())
    args = parser.parse_args()
    if args.command != "config" and not os.path.exists(CONFIG_FILE):
        print("Error: Run 'config' command first to save credentials", file=sys.stderr)
        sys.exit(1)
    args.func(args)


if __name__ == "__main__":
    main()
