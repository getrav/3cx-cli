def cmd_config(args):
    fqdn = normalize_fqdn(args.fqdn)
    config = {
        "fqdn": fqdn,
        "client_id": args.client_id,
        "client_secret": args.client_secret
    }
    save_config(config)
    print("Configuration saved.")


def cmd_get_token(args):
    config = load_config()
    token = get_token(config["fqdn"], config["client_id"], config["client_secret"])
    print(json.dumps(token, indent=2))


