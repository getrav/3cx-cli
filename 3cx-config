from threecx.common import (
    bearer_headers,
    build_api_url,
    exit_on_error,
    has_valid_cached_token,
    load_config_file,
    normalize_fqdn,
    print_json_or_text,
    request_client_token,
    save_config_file,
    token_expiry,
)

CONFIG_FILE = os.path.expanduser("~/.3cx-config.json")


def _runtime():
    """This module as seen by its importer (``cx_config`` in tests)."""
    return sys.modules[__name__]


def load_config():
    return load_config_file(CONFIG_FILE)


def save_config(config):
    save_config_file(CONFIG_FILE, config)


def get_token(fqdn, client_id, client_secret):
    return request_client_token(fqdn, client_id, client_secret)


def get_headers(config):
    now = time.time()
    if has_valid_cached_token(config, now):
        token = config["access_token"]
    else:
        token_data = get_token(config["fqdn"], config["client_id"], config["client_secret"])
        config["access_token"] = token_data["access_token"]
        # 3CX returns expires_in=60 (60-second token lifetime)
        # Cache for 45s to ensure we never use a stale token
        config["token_expiry"] = token_expiry(now, token_data.get("expires_in", 60), max_lifetime=45)
        save_config(config)
        token = config["access_token"]
    return bearer_headers(token)


def api_url(config, path):
    return build_api_url(config["fqdn"], "xapi/v1", path)


def handle_response(resp):
    exit_on_error(resp)
    if resp.text:
        print_json_or_text(resp)
    else:
        print(f"Success: {resp.status_code}")


def add_list_args(parser):
    """Add --top/--skip/--filter to any list subcommand."""
    parser.add_argument("--top", type=int, default=100, help="Max items to return")
    parser.add_argument("--skip", type=int, default=0, help="Items to skip")
    parser.add_argument("--filter", dest="odata_filter", help="OData $filter expression")


def build_list_params(args):
    """Build OData query dict from parsed args."""
    params = {"$top": args.top, "$skip": args.skip, "$orderby": "Id"}
    if hasattr(args, "odata_filter") and args.odata_filter:
        params["$filter"] = args.odata_filter
    return params


