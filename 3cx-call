#!/usr/bin/env python3
"""3CX Call Control API CLI Tool

Compatibility facade: the command, WebSocket, and parser implementations
live in the ``threecx`` package (call_commands / call_websocket /
call_parser). This module keeps every previously observable name — helpers,
handlers, constants, imported modules, and ``main()`` — and resolves itself
as the runtime facade so module-level monkeypatches (e.g. on ``cx_call``)
keep working at call time.
"""

import argparse
import json
import os
import sys
import requests
import websocket
import threading
import time

from threecx import call_commands, call_parser, call_websocket
from threecx.common import (
    bearer_headers,
    build_api_url,
    exit_on_error,
    has_valid_cached_token,
    load_config_file,
    normalize_fqdn,
    print_json_or_text,
    request_client_token,
    save_config_file,
    token_expiry,
)

CONFIG_FILE = os.path.expanduser("~/.3cx-call.json")


def _runtime():
    """This module as seen by its importer (``cx_call`` in tests)."""
    return sys.modules[__name__]


def load_config():
    return load_config_file(CONFIG_FILE)


def save_config(config):
    save_config_file(CONFIG_FILE, config)


def get_token(config):
    """Exchange API key for JWT via OAuth2 token endpoint."""
    now = time.time()
    if has_valid_cached_token(config, now):
        return config["access_token"]
    token_data = request_client_token(config["fqdn"], config["dn"], config["api_key"])
    config["access_token"] = token_data["access_token"]
    config["token_expiry"] = token_expiry(now, token_data.get("expires_in", 60))
    save_config(config)
    return config["access_token"]


def get_headers(config):
    return bearer_headers(get_token(config))


def api_url(config, path=""):
    return build_api_url(config["fqdn"], "callcontrol", path)


def ws_url(config):
    return f"wss://{config['fqdn']}/callcontrol/ws"


def handle_response(resp, verbose=False):
    """Unified response handler with 401 detail message."""
    if resp.status_code == 401:
        print("Error 401: Invalid API key. Create one in 3CX Admin Console > Integrations > API", file=sys.stderr)
        print("Make sure '3CX Call Control API Access' is checked for your application.", file=sys.stderr)
        sys.exit(1)
    exit_on_error(resp)
    if resp.text:
        print_json_or_text(resp)
    else:
        print(json.dumps({"status": resp.status_code}, indent=2))


def verbose_request(method, url, verbose=False, **kwargs):
    """Wrapper around requests that prints URL/method when verbose."""
    if verbose:
        print(f"[{method.upper()}] {url}", file=sys.stderr)
    return getattr(requests, method)(url, **kwargs)


def cmd_config(args):
    fqdn = normalize_fqdn(args.fqdn)
    config = {
        "fqdn": fqdn,
        "api_key": args.api_key,
        "dn": args.dn
    }
    save_config(config)
    print("Configuration saved.")


def cmd_status(args):
    return call_commands.cmd_status(_runtime(), args)


def cmd_devices(args):
    return call_commands.cmd_devices(_runtime(), args)


def cmd_make_call(args):
    return call_commands.cmd_make_call(_runtime(), args)


def cmd_participant(args):
    return call_commands.cmd_participant(_runtime(), args)


def cmd_action(args):
    return call_commands.cmd_action(_runtime(), args)


def cmd_listen(args):
    return call_websocket.cmd_listen(_runtime(), args)


def cmd_stream(args):
    return call_commands.cmd_stream(_runtime(), args)


def main():
    parser = call_parser.build_parser(_runtime())
    args = parser.parse_args()
    if args.command != "config" and not os.path.exists(CONFIG_FILE):
        print("Error: Run 'config' command first to save credentials", file=sys.stderr)
        sys.exit(1)
    args.func(args)


if __name__ == "__main__":
    main()
